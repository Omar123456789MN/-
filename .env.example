# ---- أساسي ----
PORT=3000
# سلسلة عشوائية طويلة (32 حرفاً على الأقل): openssl rand -hex 32
JWT_SECRET=
# اجعلها true عند النشر على HTTPS
COOKIE_SECURE=false
# اجعلها false لإغلاق التسجيل بعد إنشاء حسابك
ALLOW_SIGNUP=true
DB_PATH=./mmai.db

# ---- النموذج (بدّل المزوّد بتغيير هذا السطر فقط) ----
# anthropic  أو  openai (يعمل أيضاً مع أي خدمة متوافقة مع OpenAI مثل OpenRouter / Groq / Ollama)
PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1
